{
  "schema_version": "1.0",
  "contract_version": "1.0.0",
  "contract_id": "kubernetes-ecosystem-profile",
  "description": "Source-only SUDO identity policy for future MAKE workloads in both K3s clusters.",
  "policy_owner": "sudo",
