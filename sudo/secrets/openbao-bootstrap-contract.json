{
  "schema_version": "1.0",
  "contract_version": "1.0.0",
  "contract_id": "openbao-bootstrap-contract",
  "description": "SUDO custody contract for one-time GCP OpenBao initialization.",
  "policy_owner": "sudo",
  "consumer_owners": [
    "make"
  ],
  "proof_status": "source-only",
  "environment": "environment-gcp",
  "private_custody": {
    "root": ".local/sudo/openbao",
    "storage": "sops-age",
    "ignored": true,
    "directory_mode": "0700",
    "file_mode": "0600",
    "plaintext_values_tracked": false,
    "publication": "create-only"
  },
  "cluster": {
    "name": "gcp",
    "service": "openbao-active.openbao.svc.cluster.local",
    "port": 8200,
    "tls_required": true,
    "external_endpoint": false
  },
  "initialization": {
    "status": "blocked-independent-custody-required",
    "shares": 5,
    "threshold": 3,
    "storage": "sops-age",
    "required_outputs": [
      "root_token",
      "unseal_shares",
      "release_feed_role"
    ]
  },
  "kubernetes_auth_inputs": {
    "status": "blocked",
    "reason": "K3s API CA and reviewer identity handoffs are not implemented"
  },
  "kubernetes_auth": {
    "mount": "auth/kubernetes",
    "role": "release-feed",
    "service_account": "release-feed",
    "namespace": "release-feed",
    "audience": "openbao",
    "policy": "release-feed"
  }
}
