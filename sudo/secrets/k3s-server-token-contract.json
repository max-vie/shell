{
  "schema_version": "1.0",
  "contract_version": "1.0.0",
  "contract_id": "k3s-server-token-contract",
  "policy_owner": "sudo",
  "consumer_owner": "init",
  "proof_status": "source-only",
  "token": {
    "type": "server",
    "format": "short-password",
    "purpose": "initial-self-signed-ca-bootstrap",
    "random_bytes": 32,
    "encoding": "lowercase-hex",
    "encoded_length": 64,
    "trailing_newline": true
  },
  "storage": {
    "root": ".local/sudo/k3s",
    "directory_mode": "0700",
    "file_mode": "0600",
    "owner": "current-user",
    "ignored": true,
    "publication": "create-only",
    "rotation": "manual"
  },
  "clusters": {
    "gcp": {
      "inventory_group": "gcp_k3s_servers",
      "token_path": ".local/sudo/k3s/gcp/server-token"
    },
    "proxmox": {
      "inventory_group": "proxmox_k3s_servers",
      "token_path": ".local/sudo/k3s/proxmox/server-token"
    }
  }
}
