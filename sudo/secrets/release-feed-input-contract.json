{
  "schema_version": "1.0",
  "contract_version": "1.0.0",
  "contract_id": "release-feed-input-contract",
  "description": "SUDO custody contract for Harbor and release-feed bootstrap inputs.",
  "policy_owner": "sudo",
  "consumer_owners": [
    "make"
  ],
  "proof_status": "source-only",
  "environment": "environment-gcp",
  "private_custody": {
    "root": ".local/sudo/release-feed",
    "storage": "sops-age",
    "ignored": true,
    "directory_mode": "0700",
    "file_mode": "0600",
    "plaintext_values_tracked": false
  },
  "inputs": {
    "harbor": {
      "path": ".local/sudo/release-feed/input-set/harbor.sops.json",
      "storage": "sops-age",
      "phase": "before-harbor",
      "required_keys": [
        "admin_password",
        "core_key",
        "core_xsrf_key",
        "jobservice_secret",
        "registry_http_secret",
        "database_password",
        "registry_username",
        "registry_password"
      ]
    },
    "release_feed": {
      "path": ".local/sudo/release-feed/input-set/release-feed.sops.json",
      "storage": "sops-age",
      "phase": "before-openbao-bootstrap",
      "required_keys": [
        "read_token",
        "write_token"
      ]
    },
    "harbor_robots": {
      "path": ".local/sudo/release-feed/harbor-robots.sops.json",
      "storage": "sops-age",
      "producer": "make-after-harbor-bootstrap",
      "consumers": [
        "make",
        "tar"
      ],
      "phase": "after-harbor",
      "required_keys": [
        "publisher",
        "puller"
      ]
    },
    "age_key": {
      "path": ".local/sudo/release-feed/age-key.txt",
      "storage": "plaintext-age-identity",
      "consumer": "SOPS_AGE_KEY_FILE",
      "ignored": true,
      "file_mode": "0600"
    }
  },
  "repository_policy": {
    "contract_tracked": true,
    "private_values_tracked": false
  }
}
